# ColtIDE — template env file (copy to .env.dev and fill in after deploy)

COLTIDE_COGNITO_DOMAIN=coltide-ide-{stage}.auth.us-east-1.amazoncognito.com
COLTIDE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COLTIDE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COLTIDE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COLTIDE_AWS_REGION=us-east-1
COLTIDE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
COLTIDE_VAULT_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
